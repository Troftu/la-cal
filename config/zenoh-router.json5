// Loopback-only project ASB router; no discovery, plugins or credentials.
{
  mode: "router",
  listen: { endpoints: ["tcp/127.0.0.1:7447"] },
  connect: { endpoints: [] },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false },
  },
  plugins_loading: { enabled: false },
}
